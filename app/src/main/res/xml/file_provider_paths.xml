<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- App-specific external files directory (API 29+) -->
    <external-files-path
        name="external_files"
        path="Download/"/>

    <!-- Public Downloads directory (API < 29) -->
