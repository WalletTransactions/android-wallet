<?xml version="1.0" encoding="utf-8"?>
<!--
  Нижний лист «Добавить/Редактировать курс». Открывается по клику на строку истории
  курса или по кнопке «+ Добавить курс» на карточке пары.
  dialogTitle меняет текст, btnDelete скрывается (visibility="gone") для нового курса.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_edit_rate_dialog_title_text"
        android:textSize="21sp"
        android:textStyle="bold"
        android:fontFamily="@font/caprasimo"
        android:textColor="@color/colorTextPrimary"
        android:layout_marginBottom="16dp"/>

    <TextView style="@style/SettingsGroupLabel" android:text="@string/dialog_edit_rate_text_1"/>
    <!-- Дата не набирается с клавиатуры: тап открывает наш календарь
         (CalendarPicker), поэтому поле не фокусируется и без курсора. -->
    <EditText
        android:id="@+id/inputDate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_pill"
        android:clickable="true"
        android:cursorVisible="false"
        android:focusable="false"
        android:hint="@string/dialog_edit_rate_input_date_hint"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView style="@style/SettingsGroupLabel" android:text="@string/dialog_edit_rate_text_2"/>
    <EditText
        android:id="@+id/inputRate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_input_pill"
        android:hint="0.0000"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:inputType="numberDecimal"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_pill_outline_expanse"
            android:gravity="center"
            android:text="@string/dialog_edit_rate_btn_delete_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorexpanse"
            android:onClick="onDeleteRate"/>

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center"
            android:text="@string/dialog_edit_rate_btn_cancel_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:onClick="onCancelRate"/>

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_primary"
            android:gravity="center"
            android:text="@string/dialog_edit_rate_btn_save_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorSurface"
            android:onClick="onSaveRate"/>
    </LinearLayout>
</LinearLayout>