<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран «Операции» — таб нижней панели (navOps).

  Шапка собрана из общих блоков, тех же, что на «Кошельках» и «Отчётах»:
  view_tab_title (заголовок) + своя кнопка группировки + view_tab_actions
  (фильтр, валюта) и view_period_summary (период, состояние денег, активный фильтр).
  Оживляет их BaseTabActivity, поэтому период и фильтр не сбрасываются при
  переходе на другой таб.

  Toolbar и боковой drawer убраны: currencyEq переехал в общую пилюлю шапки,
  группировка — в кнопку рядом с ней, а пункты drawer'а давно дублирует «Ещё».
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".Activities.MainActivity">

    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <include layout="@layout/view_tab_title"/>

        <!-- Группировка ленты: раньше подменю Toolbar, теперь попап у кнопки. -->
        <TextView
            android:id="@+id/btnGroupBy"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:onClick="onPickGrouping"
            tools:text="По дате"/>

        <include layout="@layout/view_tab_actions"/>
    </LinearLayout>

    <!--
      Раньше: ScrollView → ListView с высотой «по всем строкам» (setListViewHeightBasedOnChildren).
      Так ListView создавал строку под каждую операцию сразу: за период «с 2018» это 8 тыс.
      строк на главном потоке, и старт висел до ANR. Теперь список прокручивается сам и
      переиспользует строки, а сводка периода уезжает вверх через AppBarLayout. Сводка
      остаётся в дереве окна, поэтому findViewById из BaseTabActivity её находит.
    -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/scrollable"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerRow"
        android:layout_above="@+id/bottomNav">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/summaryBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:stateListAnimator="@null"
            app:elevation="0dp">

            <!-- layout_width/height обязательны: без них <include> не применит scrollFlags. -->
            <include
                layout="@layout/view_period_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_scrollFlags="scroll"/>
        </com.google.android.material.appbar.AppBarLayout>

        <ListView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:nestedScrollingEnabled="true"
            android:paddingTop="4dp"
            android:paddingBottom="24dp"
            android:scrollbars="none"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottomNav"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="12dp"
        android:layout_marginRight="18dp"
        android:onClick="btnUp"
        app:backgroundTint="@color/colorSurfaceAlt"
        app:fabCustomSize="36dp"
        app:tint="@null"
        app:srcCompat="@drawable/stm_up"/>

    <include layout="@layout/view_bottom_nav"/>

</RelativeLayout>
