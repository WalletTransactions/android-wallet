<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран «Долги» (openspec debts, спека «Экран „Долги“»; раскладка — list-screen-layout):
  фиксированный блок фильтра (поиск, чипы направления, чип «Показывать архивные»), под ним
  в ScrollView итоги «Мне должны» / «Я должен» и контрагенты с займами. Строки строит
  DebtsActivity в debtsList. Открывается из «Ещё».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:src="@drawable/ic_nav_back"
            android:onClick="btnUp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/debts_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/caprasimo"
            android:textColor="@color/colorTextPrimary"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:text="@string/counterparties_title"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:onClick="onOpenCounterparties"/>
    </LinearLayout>

    <!-- Блок фильтра (list-screen-layout): поле поиска, чипы направления и чип «Показывать
         архивные». Стоит вне ScrollView и потому не уезжает вместе со списком займов. -->
    <EditText
        android:id="@+id/debtsSearch"
        style="@style/ListSearchField"
        android:hint="@string/search_by_name_hint"
        android:inputType="text"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextHint"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/debtsChipAll"
            style="@style/FilterChip"
            android:text="@string/debts_filter_all"/>

        <TextView
            android:id="@+id/debtsChipOwedToMe"
            style="@style/FilterChip"
            android:text="@string/debts_filter_owed_to_me"/>

        <TextView
            android:id="@+id/debtsChipIOwe"
            style="@style/FilterChip"
            android:layout_marginEnd="0dp"
            android:text="@string/debts_filter_i_owe"/>
    </LinearLayout>

    <!-- Переключатель: активный красится Chips.paint, как чипы направления. Своя строка, а не
         четвёртый чип в ряд — на узком экране четыре подписи не помещаются. -->
    <TextView
        android:id="@+id/debtsShowArchived"
        style="@style/FilterChip"
        android:layout_width="wrap_content"
        android:layout_weight="0"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:text="@string/debts_show_archived"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="24dp">

            <!-- Итоги -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_pill_secondary"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/debts_owed_to_me"
                        android:textAllCaps="true"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary"/>
                    <TextView
                        android:id="@+id/debtsOwedToMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/debts_i_owe"
                        android:textAllCaps="true"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary"/>
                    <TextView
                        android:id="@+id/debtsIOwe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/debtsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/debts_empty"
                android:textColor="@color/colorTextHint"
                android:textSize="13sp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/debtsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
