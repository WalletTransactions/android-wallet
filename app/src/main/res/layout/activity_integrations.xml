<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран «Интеграции». Открывается с экрана «Ещё» (пункт «Интеграции») — до 2026-10-11
  этот блок стоял прямо на «Ещё». Панель нижней навигации не подключена — это экран
  «вглубь», шапка та же, что у «Настроек» (activity_settings.xml).
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:src="@drawable/ic_nav_back"
            android:onClick="btnUp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Интеграции"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/caprasimo"
            android:textColor="@color/colorTextPrimary"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:id="@+id/rowServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onPickServerUrl">

                    <!-- Подпись — во всю длину, сжимается значение: длинный адрес рвал подпись на две строки. Многоточие посередине — видно и начало адреса, и порт. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="Адрес сервера"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:id="@+id/serverUrlValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:text="http://localhost:8090/"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorexpanse"
                        android:layout_marginEnd="6dp"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>

                <View style="@style/MoreRowDivider"/>

                <LinearLayout
                    android:id="@+id/rowLinkServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onLinkServer">

                    <!-- Как у «Адрес сервера» выше: длинный email сжимается многоточием, а не рвёт подпись. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="Связь с Google аккаунтом"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:id="@+id/linkStatusValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:text="Не подключено"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginEnd="6dp"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>

                <View style="@style/MoreRowDivider"/>

                <!-- Telegram-бот для ввода трат — та же связка, что в веб-версии
                     (IntegrationsActivity.onTelegram, sync.TelegramLinkClient). Значение справа —
                     подключённый аккаунт, сжимается многоточием, как адрес сервера. -->
                <LinearLayout
                    android:id="@+id/rowTelegram"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onTelegram">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="Подключение к Telegram"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:id="@+id/telegramStatusValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextHint"
                        android:layout_marginEnd="6dp"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>

                <View style="@style/MoreRowDivider"/>

                <!-- Веб-версию отдаёт тот же гейтвей (GET / → wallet-web), что и API синка,
                     поэтому открывается «Адрес сервера» выше — в браузере по умолчанию. -->
                <LinearLayout
                    android:id="@+id/rowOpenWeb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onOpenWeb">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Открыть веб-версию"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="в браузере"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginEnd="6dp"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>

                <View style="@style/MoreRowDivider"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Автоматическая синхронизация"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"/>

                        <TextView
                            android:id="@+id/rowAutoConnectInterval"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="раз в час"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorexpanse"
                            android:onClick="onPickAutoConnectInterval"/>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/switchAutoConnect"
                        android:layout_width="46dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_switch_off"
                        android:onClick="onToggleAutoConnect">
                        <View
                            android:id="@+id/switchAutoConnectThumb"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_margin="2dp"
                            android:background="@drawable/bg_switch_thumb"/>
                    </FrameLayout>
                </LinearLayout>

                <View style="@style/MoreRowDivider"/>

                <!-- Ручной синк — сразу под синком по расписанию. -->
                <LinearLayout
                    android:id="@+id/rowSyncNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onSyncNow">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Синхронизировать сейчас"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:id="@+id/syncNowStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginEnd="6dp"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>

                <View style="@style/MoreRowDivider"/>

                <!-- Уведомление после фонового синка — приходит только при включённой
                     автосинхронизации, с её же задержкой (sync.NewOperationsNotifier). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Уведомлять о новых операциях"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="периодические, из бота, веба и с других устройств"
                            android:textSize="12.5sp"
                            android:textColor="@color/colorTextSecondary"/>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/switchNotifyNewOperations"
                        android:layout_width="46dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_switch_off"
                        android:onClick="onToggleNotifyNewOperations">
                        <View
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_margin="2dp"
                            android:background="@drawable/bg_switch_thumb"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>
