<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка правила повторяющейся операции: иконка «другой стороны» (статья / откуда),
  счета, расписание и ближайший повтор, сумма и переключатель «активно».
  Выключенное правило приглушено (alpha) — см. RecurringOperationListActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_row"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <FrameLayout
        android:id="@+id/recContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_circle">

                <ImageView
                    android:id="@+id/recIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/recTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"/>

                <TextView
                    android:id="@+id/recAccounts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="12sp"
                    android:textColor="@color/colorTextSecondary"/>

                <TextView
                    android:id="@+id/recSchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"/>
            </LinearLayout>

            <TextView
                android:id="@+id/recAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"/>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/recSwitch"
        android:layout_width="46dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_switch_off">
        <View
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_margin="2dp"
            android:background="@drawable/bg_switch_thumb"/>
    </FrameLayout>
</LinearLayout>
