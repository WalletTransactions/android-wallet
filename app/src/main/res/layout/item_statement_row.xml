<?xml version="1.0" encoding="utf-8"?>
<!-- Строка выписки на экране «Выписка» (StatementImportActivity.bindRow). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvRowDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/colorTextSecondary"/>

        <TextView
            android:id="@+id/tvRowAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvRowDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14.5sp"
        android:textColor="@color/colorTextPrimary"/>

    <TextView
        android:id="@+id/tvRowCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        android:textColor="@color/colorTextSecondary"/>

    <TextView
        android:id="@+id/tvRowSource"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="@color/colorTextSecondary"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvRowState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="13sp"
        android:textStyle="bold"/>
</LinearLayout>
