<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран кода доступа (LockActivity): замок, проверка текущего кода и установка нового.
  Клавиатура — те же клавиши KeypadKey, что на экране операции, только выше. Левая
  нижняя клавиша — «ОК» при установке кода (длина 4–6 выбирается этим), отпечаток на
  замке, если он включён, иначе пустая.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/colorBackground"
    android:paddingLeft="21dp"
    android:paddingRight="21dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@mipmap/main_icon"
        android:contentDescription="@null"/>

    <TextView
        android:id="@+id/lockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="22sp"
        android:fontFamily="@font/caprasimo"
        android:textColor="@color/colorTextPrimary"/>

    <TextView
        android:id="@+id/lockMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minLines="2"
        android:gravity="center"
        android:textSize="13.5sp"
        android:textColor="@color/colorTextSecondary"/>

    <LinearLayout
        android:id="@+id/lockDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"/>

    <!-- Только на замке (LockActivity.render) — security.ForgotPin. -->
    <TextView
        android:id="@+id/lockForgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:padding="8dp"
        android:text="Забыли код?"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:onClick="onForgotPin"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <include layout="@layout/lock_keypad"/>
</LinearLayout>
