<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран «Фильтр» операций. Открывается кнопкой ⛭ в шапке «Операций»
  (btnFilter/btnChangeFilter из activity_transaction_list.xml).
  Панель нижней навигации не подключена.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:src="@drawable/ic_nav_back"
            android:onClick="btnUp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Фильтр"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/caprasimo"
            android:textColor="@color/colorTextPrimary"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/filterActions"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/SettingsGroupLabel" android:text="ПОИСК ПО ТЕКСТУ"/>
            <EditText
                android:id="@+id/inputSearchText"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input_pill"
                android:hint="Название или комментарий"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:textSize="14sp"
                android:layout_marginBottom="22dp"/>

            <TextView style="@style/SettingsGroupLabel" android:text="ТИП ОПЕРАЦИИ"/>
            <LinearLayout
                android:id="@+id/chipGroupKind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="22dp">

                <TextView android:id="@+id/chipAll" style="@style/FilterChip" android:text="Все" android:background="@drawable/bg_chip_selected" android:textColor="@color/colorSurface"/>
                <!-- Иконки те же, что на чипах экрана операции. Тинт статический разметки —
                     только заготовка на первую отрисовку; реальный цвет и фон под текущий
                     выбор красит FilterActivity.paintKind() сразу в onCreate. -->
                <LinearLayout android:id="@+id/chipExpense" style="@style/FilterChipIcon">
                    <ImageView style="@style/FilterChipIconImage" android:src="@drawable/ic_kind_expense" android:tint="@color/colorTextSecondary"/>
                    <TextView style="@style/FilterChipIconLabel" android:text="Расход"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/chipIncome" style="@style/FilterChipIcon">
                    <ImageView style="@style/FilterChipIconImage" android:src="@drawable/ic_kind_income" android:tint="@color/colorTextSecondary"/>
                    <TextView style="@style/FilterChipIconLabel" android:text="Доход"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/chipTransfer" style="@style/FilterChipIcon" android:layout_marginEnd="0dp">
                    <ImageView style="@style/FilterChipIconImage" android:src="@drawable/ic_kind_transfer" android:tint="@color/colorTextSecondary"/>
                    <TextView style="@style/FilterChipIconLabel" android:text="Перевод"/>
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SettingsGroupLabel" android:text="СЧЕТА"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="22dp">

                <LinearLayout
                    android:id="@+id/rowPickCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_pill"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:onClick="onPickCategories">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Счёт затрат" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/colorTextPrimary"/>
                    <TextView android:id="@+id/categorySummary" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Все" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/colorTextSecondary" android:layout_marginEnd="6dp"/>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowPickWallets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_pill"
                    android:padding="12dp"
                    android:onClick="onPickWallets">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Кошелёк" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/colorTextPrimary"/>
                    <TextView android:id="@+id/walletSummary" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Все" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/colorTextSecondary" android:layout_marginEnd="6dp"/>
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SettingsGroupLabel" android:text="СУММА В ВАЛЮТЕ КОШЕЛЬКА"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:layout_marginBottom="22dp">

                <EditText android:id="@+id/inputAmountMin" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@drawable/bg_input_pill" android:gravity="center"
                    android:hint="от" android:inputType="numberDecimal" android:textSize="13.5sp" android:textStyle="bold"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:layout_gravity="center_vertical"
                    android:text="—" android:textColor="@color/colorTextSecondary"/>

                <EditText android:id="@+id/inputAmountMax" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@drawable/bg_input_pill" android:gravity="center"
                    android:hint="до" android:inputType="numberDecimal" android:textSize="13.5sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Текст дописывает FilterActivity: валюта эквивалента общая для всех табов
                 и выбирается в шапке (BaseTabActivity.onPickCurrencyEq), тут не рубли жёстко,
                 а то, что выбрано сейчас. -->
            <TextView android:id="@+id/labelEqRange" style="@style/SettingsGroupLabel" android:text="СУММА В ЭКВИВАЛЕНТЕ"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp">

                <EditText android:id="@+id/inputEqMin" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@drawable/bg_input_pill" android:gravity="center"
                    android:hint="от" android:inputType="numberDecimal" android:textSize="13.5sp" android:textStyle="bold"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:layout_gravity="center_vertical"
                    android:text="—" android:textColor="@color/colorTextSecondary"/>

                <EditText android:id="@+id/inputEqMax" android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@drawable/bg_input_pill" android:gravity="center"
                    android:hint="до" android:inputType="numberDecimal" android:textSize="13.5sp" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/filterActions"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center"
            android:text="Сбросить"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:onClick="onResetFilter"/>

        <TextView
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_primary"
            android:gravity="center"
            android:text="Показать 14"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorSurface"
            android:onClick="onApplyFilter"/>
    </LinearLayout>
</RelativeLayout>