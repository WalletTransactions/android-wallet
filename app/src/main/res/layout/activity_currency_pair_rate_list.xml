<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран истории курса валютной пары — тот же визуальный язык, что «Операции»/
  «Курсы валют»: кастомная шапка без Toolbar/ActionBar, Caprasimo в заголовке,
  карточки-пилюли (bg_pill_secondary/bg_card/bg_pill_dashed). Экран «вглубь»
  (открывается из списка пар) — панель нижней навигации не подключена, как и
  у activity_currencypair_list.xml.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:src="@drawable/ic_nav_back"
            android:onClick="btnUp"/>

        <FrameLayout
            android:id="@+id/toolbarTitleFrame"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>

        <ImageButton
            android:id="@+id/btnDownloadRates"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:src="@android:drawable/stat_sys_download"
            android:onClick="btnDownloadRates"/>

        <!-- Удалить свою пару вместе с историей курса; у общей пары скрыта
             (CurrencyPairRateListActivity.onCreate, spec currency-pairs). -->
        <ImageButton
            android:id="@+id/btnDeletePair"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_secondary"
            android:contentDescription="@string/activity_currency_pair_rate_list_btn_delete_pair_content_description"
            android:src="@drawable/ic_delete_forever_black_24dp"
            android:tint="@color/colorexpanse"
            android:visibility="gone"
            android:onClick="onDeletePair"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/periodPill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_secondary"
        android:padding="5dp">

        <fragment
            android:id="@+id/fragmentDatePeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:name="com.example.wallettransactions.Activities.Fragments.ChooseDatePeriodFragment"
            tools:layout="@layout/fragment_choose_date_period"/>
    </FrameLayout>

    <!-- Курс, график и границы периода — одной карточкой, как в макете. -->
    <LinearLayout
        android:id="@+id/rateCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/periodPill"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rateValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/caprasimo"
                android:textColor="@color/colorTextPrimary"
                android:textSize="28sp"/>

            <TextView
                android:id="@+id/rateDelta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/colortransfer"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.example.wallettransactions.Views.RateChartView
            android:id="@+id/rateChart"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chartFrom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/colorTextHint"
                android:textSize="10.5sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/chartMinMax"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:gravity="center"
                android:textColor="@color/colorTextHint"
                android:textSize="10.5sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/chartTo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/colorTextHint"
                android:textSize="10.5sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/historyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rateCard"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="8dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            style="@style/SettingsGroupLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="0dp"
            android:text="@string/activity_currency_pair_rate_list_text_1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/activity_currency_pair_rate_list_text_2"
            android:textColor="@color/colorTextHint"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/historyHeader"
        android:layout_above="@id/btnAddRate"
        android:divider="@null"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:clipToPadding="false"/>

    <LinearLayout
        android:id="@+id/btnAddRate"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="18dp"
        android:background="@drawable/bg_pill_primary"
        android:gravity="center"
        android:onClick="onAddRateClick">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/activity_currency_pair_rate_list_text_3"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorSurface"/>
    </LinearLayout>

</RelativeLayout>
