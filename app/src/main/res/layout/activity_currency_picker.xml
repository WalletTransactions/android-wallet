<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран «Список валют» — общий выбор валюты. Используется дважды:
  1) выбор Базовой/Котируемой валюты в dialog_new_pair.xml (одиночный выбор, закрывается сразу по клику на строку);
  2) выбор валют для фильтра на «Курсы валют» (множественный выбор — не используется здесь,
     для фильтра проще держать чипы прямо на экране списка пар, см. activity_currencypair_list.xml).
  Список валют (40 позиций) заполняется кодом из одного и того же источника — currencies.json.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:src="@drawable/ic_nav_back"
            android:onClick="btnUp"/>

        <TextView
            android:id="@+id/pickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/activity_currency_picker_picker_title_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/caprasimo"
            android:textColor="@color/colorTextPrimary"/>
    </LinearLayout>

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_input_pill"
        android:hint="@string/activity_currency_picker_search_input_hint"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:textSize="13.5sp"
        android:singleLine="true"/>

    <ListView
        android:id="@+id/listCurrencies"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/colorDivider"
        android:dividerHeight="1dp"/>

    <TextView
        android:id="@+id/btnCreateCurrency"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="18dp"
        android:background="@drawable/bg_pill_dashed"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/activity_currency_picker_btn_create_currency_text"
        android:textColor="@color/colorexpanse"
        android:textSize="14sp"
        android:textStyle="bold"
        android:onClick="onCreateCurrency"/>
</LinearLayout>