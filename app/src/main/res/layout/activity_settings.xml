<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран «Настройки». Открывается с экрана «Ещё» (пункт «Настройки»).
  Панель нижней навигации не подключена — это экран «вглубь».
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:src="@drawable/ic_nav_back"
            android:onClick="btnUp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/activity_settings_text_1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/caprasimo"
            android:textColor="@color/colorTextPrimary"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/toolbar"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
              Тема оформления. Три чипа, а не тумблер: вариантов три, и «Как в системе»
              тумблером не выражается. Подсветку выбранного расставляет код
              (SettingsActivity.applyThemeChips) — здесь все три нарисованы неактивными.
            -->
            <TextView style="@style/SettingsGroupLabel" android:text="@string/activity_settings_text_2"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="22dp">

                <TextView
                    android:id="@+id/chipThemeLight"
                    style="@style/FilterChip"
                    android:text="@string/activity_settings_chip_theme_light_text"
                    android:onClick="onPickTheme"/>

                <TextView
                    android:id="@+id/chipThemeDark"
                    style="@style/FilterChip"
                    android:text="@string/activity_settings_chip_theme_dark_text"
                    android:onClick="onPickTheme"/>

                <TextView
                    android:id="@+id/chipThemeSystem"
                    style="@style/FilterChip"
                    android:layout_marginEnd="0dp"
                    android:text="@string/activity_settings_chip_theme_system_text"
                    android:onClick="onPickTheme"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="22dp"
                android:onClick="onPickLanguage">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_language"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"/>

                <TextView
                    android:id="@+id/languageValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorexpanse"
                    android:layout_marginEnd="6dp"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"/>
            </LinearLayout>

            <TextView style="@style/SettingsGroupLabel" android:text="@string/activity_settings_text_3"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="22dp">

            <LinearLayout
                android:id="@+id/rowMainCurrency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:onClick="onPickMainCurrency">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/activity_settings_text_4"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"/>

                <TextView
                    android:id="@+id/mainCurrencyValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_settings_main_currency_value_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorexpanse"
                    android:layout_marginEnd="6dp"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"/>
            </LinearLayout>

            <View style="@style/MoreRowDivider"/>

            <!-- Строки «Капитал» / «Всего с капиталом» в карточке итогов табов
                 (AppSettings.isCapitalInSummaryOn). Какие активы входят во «Всего с
                 капиталом» — галочка на самом активе. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_capital_in_summary"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/settings_capital_in_summary_hint"
                        android:textSize="12.5sp"
                        android:textColor="@color/colorTextSecondary"/>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/switchCapitalInSummary"
                    android:layout_width="46dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_switch_off"
                    android:onClick="onToggleCapitalInSummary">
                    <View
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_switch_thumb"/>
                </FrameLayout>
            </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SettingsGroupLabel" android:text="@string/activity_settings_text_5"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_settings_text_6"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/activity_settings_text_7"
                        android:textSize="12.5sp"
                        android:textColor="@color/colorTextSecondary"/>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/switchPickerKeyboard"
                    android:layout_width="46dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_switch_off"
                    android:onClick="onTogglePickerKeyboard">
                    <View
                        android:id="@+id/switchPickerKeyboardThumb"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_margin="2dp"
                        android:background="@drawable/bg_switch_thumb"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Порядок, с которым открывается экран выбора (AppSettings.getPickerSort).
                 Кнопка «⇅» в его шапке меняет порядок только на этот раз, сюда не пишет. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onPickWalletSort">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/activity_settings_text_8"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:id="@+id/walletSortValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorexpanse"
                        android:layout_marginEnd="6dp"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorDivider"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onPickCategorySort">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/activity_settings_text_9"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/activity_settings_text_10"
                            android:textSize="12.5sp"
                            android:textColor="@color/colorTextSecondary"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/categorySortValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorexpanse"
                        android:layout_marginEnd="6dp"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SettingsGroupLabel" android:text="@string/activity_settings_text_11"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/activity_settings_text_12"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <FrameLayout
                        android:id="@+id/switchAccessCode"
                        android:layout_width="46dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_switch_off"
                        android:onClick="onToggleAccessCode">
                        <View
                            android:id="@+id/switchAccessCodeThumb"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_margin="2dp"
                            android:background="@drawable/bg_switch_thumb"/>
                    </FrameLayout>
                </LinearLayout>

                <!-- Видны только при заданном коде (SettingsActivity.paintSecurity). -->
                <LinearLayout
                    android:id="@+id/rowsPinSet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorDivider"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:onClick="onChangeAccessCode">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/activity_settings_text_13"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"/>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorDivider"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:onClick="onPickLockTimeout">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/activity_settings_text_14"
                                android:textSize="14.5sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/activity_settings_text_15"
                                android:textSize="12.5sp"
                                android:textColor="@color/colorTextSecondary"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lockTimeoutValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorexpanse"
                            android:layout_marginEnd="6dp"/>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorDivider"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/activity_settings_text_16"
                                android:textSize="14.5sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary"/>

                            <!-- Текст зависит от версии Android — SettingsActivity.paintSecurity. -->
                            <TextView
                                android:id="@+id/hideRecentsHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:textSize="12.5sp"
                                android:textColor="@color/colorTextSecondary"/>
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/switchHideRecents"
                            android:layout_width="46dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_switch_off"
                            android:onClick="onToggleHideRecents">
                            <View
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_margin="2dp"
                                android:background="@drawable/bg_switch_thumb"/>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorDivider"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/labelBiometric"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/activity_settings_label_biometric_text"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextHint"/>

                    <FrameLayout
                        android:id="@+id/switchBiometric"
                        android:layout_width="46dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_switch_off"
                        android:onClick="onToggleBiometric">
                        <View
                            android:id="@+id/switchBiometricThumb"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_margin="2dp"
                            android:background="@drawable/bg_switch_thumb"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SettingsGroupLabel" android:text="@string/activity_settings_text_17"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="22dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_settings_text_18"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:id="@+id/rowRemindTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/activity_settings_row_remind_time_text"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorexpanse"
                        android:onClick="onPickRemindTime"/>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/switchRemind"
                    android:layout_width="46dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_switch_off"
                    android:onClick="onToggleRemind">
                    <View
                        android:id="@+id/switchRemindThumb"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_margin="2dp"
                        android:layout_gravity="end"
                        android:background="@drawable/bg_switch_thumb"/>
                </FrameLayout>
            </LinearLayout>

            <TextView style="@style/SettingsGroupLabel" android:text="@string/activity_settings_text_19"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="22dp">

                <!-- Импорт — с 2026-11-11 снова здесь, рядом с экспортом (до этого стоял в «Ещё»). -->
                <LinearLayout
                    android:id="@+id/rowImport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onImportFile">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/activity_more_text_7"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>

                <View style="@style/MoreRowDivider"/>

                <LinearLayout
                    android:id="@+id/rowExport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onExportDatabase">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/activity_settings_text_20"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SettingsGroupLabel" android:text="@string/activity_settings_text_21"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/rowRateApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onRateApp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/activity_settings_text_22"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorDivider"/>

                <LinearLayout
                    android:id="@+id/rowVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onVersionTap">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/activity_settings_text_23"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:id="@+id/versionValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.4.1"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/colorDivider"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/activity_settings_text_24"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:id="@+id/buildDateValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>