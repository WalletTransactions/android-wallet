<?xml version="1.0" encoding="utf-8"?>
<!--
  «Удалить данные» — экран с «Ещё» (кнопка btnDeleteAll/onDeleteAllOperations).
  Раньше эта кнопка сразу показывала диалог-подтверждение и чистила только операции
  и счета; теперь — отдельный экран с чекбоксами, что удалить, и опцией пересеять
  дефолтный набор после удаления (см. ResetDataActivity/WalletFillData.Reset*).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical"
    tools:context=".Activities.ResetDataActivity">

    <include layout="@layout/view_screen_header"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="@string/activity_reset_data_text_1"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"/>

            <TextView style="@style/SettingsGroupLabel" android:text="@string/activity_reset_data_text_2"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <CheckBox
                    android:id="@+id/chkOperations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_reset_data_chk_operations_text"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:buttonTint="@color/colorPrimary"
                    android:layout_marginBottom="12dp"/>

                <CheckBox
                    android:id="@+id/chkIcons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_reset_data_chk_icons_text"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:buttonTint="@color/colorPrimary"
                    android:layout_marginBottom="12dp"/>

                <CheckBox
                    android:id="@+id/chkCurrencyPairs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_reset_data_chk_currency_pairs_text"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:buttonTint="@color/colorPrimary"/>
            </LinearLayout>

            <TextView style="@style/SettingsGroupLabel" android:text="@string/activity_reset_data_text_3"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <CheckBox
                    android:id="@+id/chkReseed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_reset_data_chk_reseed_text"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:buttonTint="@color/colorPrimary"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnConfirmReset"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_pill_outline_expanse"
                android:onClick="onConfirmReset"
                android:stateListAnimator="@null"
                android:text="@string/activity_reset_data_btn_confirm_reset_text"
                android:textAllCaps="false"
                android:textColor="@color/colorexpanse"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <ProgressBar
                android:id="@+id/progressReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvResetStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/colorTextSecondary"
                android:textIsSelectable="true"
                android:textSize="13sp"/>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginTop="28dp" android:layout_marginBottom="18dp"
                android:background="@color/colorDivider"/>

            <TextView style="@style/SettingsGroupLabel" android:text="@string/activity_reset_data_text_4"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:text="@string/activity_reset_data_text_5"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <CheckBox
                    android:id="@+id/chkHardReseed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/activity_reset_data_chk_hard_reseed_text"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="15sp"
                    android:buttonTint="@color/colorPrimary"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnHardWipe"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_pill_outline_expanse"
                android:onClick="onHardWipe"
                android:stateListAnimator="@null"
                android:text="@string/activity_reset_data_btn_hard_wipe_text"
                android:textAllCaps="false"
                android:textColor="@color/colorexpanse"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
