<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран «ИИ» (AiActivity): трата своими словами через wallet-ai — поле ввода и
  ожидание; черновик правится и записывается в окне операции (TransactionActivity). Открывается с «Ещё» и через
  «Поделиться» текстом. Экран «вглубь», без нижней панели — шапка как у
  «Интеграций» (activity_integrations.xml). Поведение — openspec
  changes/add-ai-client, spec ai-expense-entry.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:src="@drawable/ic_nav_back"
            android:onClick="btnUp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="ИИ"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/caprasimo"
            android:textColor="@color/colorTextPrimary"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Ввод -->
            <LinearLayout style="@style/AiCard">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Трата своими словами"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"/>

                <EditText
                    android:id="@+id/editText"
                    style="@style/AiValue"
                    android:layout_marginTop="10dp"
                    android:minLines="3"
                    android:gravity="top|start"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:hint="Например: вчера такси 450 с тинькоффа"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvCounter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0 / 500"
                        android:textSize="12.5sp"
                        android:textColor="@color/colorTextSecondary"/>

                    <ImageButton
                        android:id="@+id/btnMic"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_pill_secondary"
                        android:src="@android:drawable/ic_btn_speak_now"
                        android:contentDescription="Надиктовать"
                        android:onClick="onMic"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnParse"
                    style="@style/AiButtonPrimary"
                    android:text="Разобрать"
                    android:onClick="onParse"/>

                <TextView android:id="@+id/tvWarning" style="@style/AiWarning"/>
            </LinearLayout>

            <!-- Ожидание: синк, затем разбор -->
            <LinearLayout
                android:id="@+id/progressBox"
                style="@style/AiCard"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14.5sp"
                    android:textColor="@color/colorTextPrimary"/>

                <Button
                    style="@style/AiButtonOutline"
                    android:text="Отменить"
                    android:onClick="onCancel"/>
            </LinearLayout>

            <!-- ИИ не справился / недоступен -->
            <LinearLayout
                android:id="@+id/messageBox"
                style="@style/AiCard"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14.5sp"
                    android:textColor="@color/colorTextPrimary"/>

                <Button
                    android:id="@+id/btnManual"
                    style="@style/AiButtonOutline"
                    android:text="Заполнить вручную"
                    android:onClick="onManual"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDone"
                style="@style/AiNote"
                android:layout_marginBottom="14dp"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:textColor="@color/colorprofit"/>

            <!-- Черновик не открыт сразу: кошелёк или категория из разбора пропали с
                 телефона. Правка и запись — в окне операции (TransactionActivity). -->
            <LinearLayout
                android:id="@+id/problemBox"
                style="@style/AiCard"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvProblem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorexpanse"/>

                <TextView
                    android:id="@+id/tvProblemDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12.5sp"
                    android:textColor="@color/colorTextSecondary"/>

                <Button
                    style="@style/AiButtonOutline"
                    android:text="Синхронизировать и повторить"
                    android:onClick="onSyncRetry"/>

                <Button
                    style="@style/AiButtonOutline"
                    android:text="Открыть операцию"
                    android:onClick="onOpenOperation"/>
            </LinearLayout>

            <!-- Окно операции закрыли без сохранения: черновик жив, ИИ повторно не зовём. -->
            <LinearLayout
                android:id="@+id/pendingBox"
                style="@style/AiCard"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Разбор не записан"
                    android:textSize="14.5sp"
                    android:textColor="@color/colorTextPrimary"/>

                <Button
                    style="@style/AiButtonOutline"
                    android:text="Открыть снова"
                    android:onClick="onOpenOperation"/>
            </LinearLayout>

            <!-- Импорт выписки — свой экран (StatementImportActivity, add-ai-statement-import). -->
            <LinearLayout style="@style/AiCard">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Выписка из банка"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="PDF или CSV из приложения банка — ИИ разберёт операции и подберёт категории, вы проверите и запишете"
                    android:textSize="12.5sp"
                    android:textColor="@color/colorTextSecondary"/>

                <Button
                    style="@style/AiButtonOutline"
                    android:text="Загрузить выписку"
                    android:onClick="onStatementImport"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
