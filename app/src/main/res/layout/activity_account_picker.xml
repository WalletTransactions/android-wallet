<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран выбора счёта — открывается при вводе операции вместо прежнего списка-диалога.

  Список — та же таблица кошельков, что в отчёте «Кошельки», но без остатка на
  начало периода и без изменения (account_picker_item_layout.xml).

  Сверху переключатель «Категории / Кошельки» и поиск по названию. Когда экран
  открыт под конкретный слот операции (статья расхода, кошелёк, счёт комиссии),
  переключатель скрыт: тип уже задан, и подменять его нельзя.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:contentDescription="@string/activity_account_picker_btn_up_content_description"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_back"
            android:onClick="btnUp"/>

        <TextView
            android:id="@+id/pickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/caprasimo"
            android:text="@string/activity_account_picker_picker_title_text"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp"/>

        <!-- Порядок строк (AccountPickerActivity.onPickSort): тап — следующий режим
             видимого списка по кругу, подпись — текущий. Тот же вид, что у «По дате» в ленте. -->
        <TextView
            android:id="@+id/btnSort"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="⇅"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:onClick="onPickSort"/>
    </LinearLayout>

    <!-- Переключатель типа: скрыт, когда экран открыт под конкретный тип счёта -->
    <LinearLayout
        android:id="@+id/rowKindFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/kindCategories"
            style="@style/FilterChip"
            android:text="@string/activity_account_picker_kind_categories_text"
            android:onClick="onKindFilterClick"/>

        <TextView
            android:id="@+id/kindWallets"
            style="@style/FilterChip"
            android:layout_marginEnd="0dp"
            android:text="@string/activity_account_picker_kind_wallets_text"
            android:onClick="onKindFilterClick"/>
    </LinearLayout>

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_input_pill"
        android:hint="@string/activity_account_picker_search_input_hint"
        android:inputType="text"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:singleLine="true"
        android:textSize="13.5sp"/>

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/activity_account_picker_empty_state_text"
        android:textColor="@color/colorTextHint"
        android:textSize="13sp"
        android:visibility="gone"/>

    <ListView
        android:id="@+id/listAccounts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"/>

    <!-- Только в режиме справочника (при выборе счёта для операции заводить новый
         нечем) — та же строка-«+» под списком, что и на «Курсы валют»
         (activity_currencypair_list.xml/btnAddPair), вместо прежней иконки в шапке. -->
    <LinearLayout
        android:id="@+id/btnAddAccountRow"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="18dp"
        android:background="@drawable/bg_pill_dashed"
        android:gravity="center"
        android:visibility="gone"
        android:onClick="onAddAccount">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/activity_account_picker_text_1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorexpanse"/>
    </LinearLayout>
</LinearLayout>
