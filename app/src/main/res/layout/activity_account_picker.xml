<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран выбора счёта — открывается при вводе операции вместо прежнего списка-диалога.

  Список — та же таблица кошельков, что в отчёте «Кошельки», но без остатка на
  начало периода и без изменения (account_picker_item_layout.xml).

  Сверху переключатель «Категории / Кошельки» и поиск по названию. Когда экран
  открыт под конкретный слот операции (статья расхода, кошелёк, счёт комиссии),
  переключатель скрыт: тип уже задан, и подменять его нельзя.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:contentDescription="@string/activity_account_picker_btn_up_content_description"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_back"
            android:onClick="btnUp"/>

        <TextView
            android:id="@+id/pickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/caprasimo"
            android:text="@string/activity_account_picker_picker_title_text"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp"/>

        <!-- Порядок строк (AccountPickerActivity.onPickSort): тап — следующий режим
             видимого списка по кругу, подпись — текущий. Тот же вид, что у «По дате» в ленте. -->
        <TextView
            android:id="@+id/btnSort"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="⇅"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:onClick="onPickSort"/>
    </LinearLayout>

    <!-- Переключатель типа: скрыт, когда экран открыт под конкретный тип счёта -->
    <LinearLayout
        android:id="@+id/rowKindFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/kindCategories"
            style="@style/FilterChip"
            android:text="@string/activity_account_picker_kind_categories_text"
            android:onClick="onKindFilterClick"/>

        <TextView
            android:id="@+id/kindWallets"
            style="@style/FilterChip"
            android:layout_marginEnd="0dp"
            android:text="@string/activity_account_picker_kind_wallets_text"
            android:onClick="onKindFilterClick"/>
    </LinearLayout>

    <!-- Долги (debts): при выборе статьи расхода/дохода — «Дать в долг», «Взять в долг»,
         «Вернуть»; результат — перевод между кошельком и займом -->
    <LinearLayout
        android:id="@+id/rowDebtActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/debtActionGive"
            style="@style/FilterChip"
            android:text="@string/debt_action_give"
            android:onClick="onDebtActionClick"/>

        <TextView
            android:id="@+id/debtActionTake"
            style="@style/FilterChip"
            android:text="@string/debt_action_take"
            android:onClick="onDebtActionClick"/>

        <TextView
            android:id="@+id/debtActionReturn"
            style="@style/FilterChip"
            android:layout_marginEnd="0dp"
            android:text="@string/debt_action_return"
            android:onClick="onDebtActionClick"/>
    </LinearLayout>

    <!-- Строка поиска (openspec catalog-filters-panel): поле видно всегда; в справочнике справа от
         него кнопка «Фильтры», при выборе счёта для операции кнопки нет и поле на всю ширину. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_input_pill"
            android:hint="@string/activity_account_picker_search_input_hint"
            android:inputType="text"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:singleLine="true"
            android:textSize="13.5sp"/>

        <!-- Раскрывает и сворачивает панель фильтров; подпись и число условий — в
             AccountPickerActivity.paintFiltersButton. -->
        <TextView
            android:id="@+id/btnFilters"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:textColor="@color/colorTextSecondary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:onClick="onToggleFiltersPanel"/>
    </LinearLayout>

    <!-- Панель фильтров справочника «Кошельки и категории»: только в справочнике, по умолчанию
         свёрнута (исходное состояние — AppSettings.isCatalogPanelOpen). На «Кошельках» — типы
         кошельков, на «Категориях» — виды; «Показывать архивные» общий. Вне прокрутки. -->
    <LinearLayout
        android:id="@+id/catalogFilterPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/rowWalletTypeFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/walletTypeAll"
                style="@style/FilterChip"
                android:text="@string/picker_wallet_type_all"
                android:onClick="onWalletTypeClick"/>

            <TextView
                android:id="@+id/walletTypeRegular"
                style="@style/FilterChip"
                android:text="@string/picker_wallet_type_regular"
                android:onClick="onWalletTypeClick"/>

            <TextView
                android:id="@+id/walletTypeAssets"
                style="@style/FilterChip"
                android:text="@string/picker_wallet_type_assets"
                android:onClick="onWalletTypeClick"/>

            <TextView
                android:id="@+id/walletTypeDebts"
                style="@style/FilterChip"
                android:layout_marginEnd="0dp"
                android:text="@string/picker_wallet_type_debts"
                android:onClick="onWalletTypeClick"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowCategoryKindFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/catalogKindExpense"
                style="@style/FilterChip"
                android:text="@string/category_kind_expense"
                android:onClick="onCategoryKindClick"/>

            <TextView
                android:id="@+id/catalogKindIncome"
                style="@style/FilterChip"
                android:text="@string/category_kind_income"
                android:onClick="onCategoryKindClick"/>

            <TextView
                android:id="@+id/catalogKindBoth"
                style="@style/FilterChip"
                android:layout_marginEnd="0dp"
                android:text="@string/category_kind_both"
                android:onClick="onCategoryKindClick"/>
        </LinearLayout>

        <!-- Переключатель, как «Показывать архивные» на «Долгах»: активный красится Chips.paint.
             Действует на оба списка. -->
        <TextView
            android:id="@+id/pickerShowArchived"
            style="@style/FilterChip"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="10dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="@string/debts_show_archived"
            android:onClick="onShowArchivedClick"/>
    </LinearLayout>

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/activity_account_picker_empty_state_text"
        android:textColor="@color/colorTextHint"
        android:textSize="13sp"
        android:visibility="gone"/>

    <ListView
        android:id="@+id/listAccounts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"/>

    <!-- Только в режиме справочника (при выборе счёта для операции заводить новый
         нечем) — та же строка-«+» под списком, что и на «Курсы валют»
         (activity_currencypair_list.xml/btnAddPair), вместо прежней иконки в шапке. -->
    <LinearLayout
        android:id="@+id/btnAddAccountRow"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_margin="18dp"
        android:background="@drawable/bg_pill_dashed"
        android:gravity="center"
        android:visibility="gone"
        android:onClick="onAddAccount">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/activity_account_picker_text_1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorexpanse"/>
    </LinearLayout>
</LinearLayout>
