<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка отчёта по категории (прототип 2a, блок isReport):
  иконка · название · сумма · доля, под ними — полоса.
  Строки лежат внутри карточки экрана, поэтому своей подложки у них нет.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/textName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Категория"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13.5sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/textBalance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0.00"
            android:textColor="@color/colorTextPrimary"
            android:textSize="13.5sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/textShare"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0%"
            android:textColor="@color/colorTextHint"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Полоса: доли задаются весами из адаптера, поэтому измерять ничего не нужно. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="9dp"
        android:background="@drawable/bg_bar_track"
        android:orientation="horizontal"
        android:weightSum="1">

        <View
            android:id="@+id/barFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="@drawable/bg_bar_fill"/>

        <View
            android:id="@+id/barRest"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- Разбивка по валютам — появляется только у мультивалютных категорий. -->
    <LinearLayout
        android:id="@+id/ListViewFc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
</LinearLayout>
