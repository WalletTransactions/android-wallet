<?xml version="1.0" encoding="utf-8"?>
<!--
  Карточка контрагента (openspec counterparty-card): иконка, имя, комментарий, блок контакта
  телефона, итог по займам и список займов (тап — карточка займа), «В архив» и «Удалить».
  Займы и итог строит CounterpartyCardActivity. Открывается тапом по строке «Контрагентов».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <include layout="@layout/view_screen_header"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Иконка: тап — выбор из библиотеки иконок -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:onClick="pickIconClick">

                <ImageView
                    android:id="@+id/counterpartyIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:scaleType="centerInside"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:alpha="0.8"
                    android:paddingBottom="5dp"
                    android:text="@string/counterparty_icon_hint"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="10sp"/>
            </FrameLayout>

            <TextView
                style="@style/CounterpartyCardLabel"
                android:text="@string/debt_counterparty_name_hint"/>

            <EditText
                android:id="@+id/counterpartyName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_pill"
                android:inputType="textCapWords"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"/>

            <TextView
                style="@style/CounterpartyCardLabel"
                android:text="@string/counterparty_comment_label"/>

            <EditText
                android:id="@+id/counterpartyComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_pill"
                android:hint="@string/counterparty_comment_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="52dp"
                android:padding="14dp"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextHint"
                android:textSize="15sp"/>

            <!-- Контакт телефона: ключ локальный, имя контакта не читаем (нет READ_CONTACTS) -->
            <TextView
                style="@style/CounterpartyCardLabel"
                android:text="@string/counterparty_contact_label"/>

            <TextView
                android:id="@+id/counterpartyContactStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/colorTextPrimary"
                android:textSize="15sp"/>

            <LinearLayout
                android:id="@+id/counterpartyContactButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnContactBind"
                    style="@style/CounterpartyCardButton"
                    android:onClick="onContactBind"
                    android:text="@string/counterparty_contact_bind"/>

                <Button
                    android:id="@+id/btnContactOpen"
                    style="@style/CounterpartyCardButton"
                    android:onClick="onContactOpen"
                    android:text="@string/counterparty_contact_open"/>

                <Button
                    android:id="@+id/btnContactUnbind"
                    style="@style/CounterpartyCardButton"
                    android:layout_marginEnd="0dp"
                    android:onClick="onContactUnbind"
                    android:text="@string/counterparty_contact_unbind"/>
            </LinearLayout>

            <!-- Итог и займы -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CounterpartyCardLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="@string/counterparty_loans_label"/>

                <TextView
                    android:id="@+id/counterpartyTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/counterpartyLoans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical"/>

            <Button
                android:id="@+id/btnCounterpartyArchive"
                style="@style/CounterpartyCardButton"
                android:layout_width="match_parent"
                android:layout_marginBottom="10dp"
                android:layout_marginEnd="0dp"
                android:onClick="onToggleArchive"/>

            <Button
                android:id="@+id/btnCounterpartyDelete"
                style="@style/CounterpartyCardButton"
                android:layout_width="match_parent"
                android:layout_marginEnd="0dp"
                android:onClick="onDelete"
                android:text="@string/counterparty_delete"
                android:textColor="@color/colorexpanse"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
