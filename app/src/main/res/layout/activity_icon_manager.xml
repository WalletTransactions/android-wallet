<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран «Иконки и категории». Раскладка — стандарт list-screen-layout: шапка, поиск по
  названию в «пилюле», список иконок по группам, постоянная нижняя кнопка «+ Иконка».
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <include
        android:id="@+id/iconHeader"
        layout="@layout/view_screen_header"/>

    <EditText
        android:id="@+id/iconSearch"
        style="@style/ListSearchField"
        android:layout_below="@id/iconHeader"
        android:hint="@string/icon_manager_search_hint"
        android:inputType="text"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextHint"/>

    <ExpandableListView
        android:id="@+id/expandableListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/iconSearch"
        android:layout_above="@id/btnAddIcon"
        android:layout_margin="8dp"
        android:divider="@color/colorDivider"
        android:dividerHeight="1dp" />

    <!-- Пустая выдача поиска: поверх списка, нижняя кнопка остаётся на месте. -->
    <TextView
        android:id="@+id/iconsEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/iconSearch"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/search_nothing_found"
        android:textColor="@color/colorTextHint"
        android:textSize="13sp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/btnAddIcon"
        style="@style/ListAddButton"
        android:layout_alignParentBottom="true"
        android:layout_margin="18dp"
        android:text="@string/icon_manager_add"/>

</RelativeLayout>
