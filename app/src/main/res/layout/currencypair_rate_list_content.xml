<?xml version="1.0" encoding="utf-8"?>
<!-- Строка курса в истории пары — та же карточка-строка, что и в остальных списках
     редизайна (bg_card_row), вместо плоского текста. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_row"
    android:elevation="1dp"
    android:padding="14dp"
    android:layout_marginTop="8dp">

    <TextView
        android:id="@+id/textDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="13.5sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextSecondary"/>

    <TextView
        android:id="@+id/textRate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextPrimary"/>

    <!-- Изменение к предыдущему (более раннему) курсу — курсы идут от новых к старым. -->
    <TextView
        android:id="@+id/textDelta"
        android:layout_width="52dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:gravity="end"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:textColor="@color/colortransfer"/>

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:src="@drawable/ic_chevron_right"/>
</LinearLayout>
