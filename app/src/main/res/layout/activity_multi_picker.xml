<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран множественного выбора счетов (прототип 2a, блок isPick).
  Открывается из «Фильтра» для строк «Счёт затрат» и «Кошелёк».
  Заголовок задаётся из кода: pickerTitle.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill_secondary"
            android:contentDescription="Назад"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_nav_back"
            android:onClick="btnUp"/>

        <TextView
            android:id="@+id/pickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/caprasimo"
            android:text="Счёт затрат"
            android:textColor="@color/colorTextPrimary"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/btnToggleAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill_secondary"
            android:clickable="true"
            android:focusable="true"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="Выбрать все"
            android:textColor="@color/colorexpanse"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:onClick="onToggleAll"/>
    </LinearLayout>

    <TextView
        android:id="@+id/pickerCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:text="Все"
        android:textColor="@color/colorTextSecondary"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_input_pill"
        android:hint="Поиск по названию"
        android:inputType="text"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:singleLine="true"
        android:textSize="13.5sp"/>

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Ничего не найдено"
        android:textColor="@color/colorTextHint"
        android:textSize="13sp"
        android:visibility="gone"/>

    <!-- Счетов бывает много, поэтому список скроллится сам, без ScrollView-обёртки. -->
    <ListView
        android:id="@+id/listItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:background="@drawable/bg_card_row"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"/>

    <TextView
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="18dp"
        android:background="@drawable/bg_pill_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Готово"
        android:textColor="@color/colorSurface"
        android:textSize="15sp"
        android:textStyle="bold"
        android:onClick="onDone"/>
</LinearLayout>
