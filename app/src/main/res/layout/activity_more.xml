<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран «Ещё» — таб нижней панели (navMore). Пункты бокового drawer переехали сюда.
  Панель нижней навигации подключена (view_bottom_nav, активный таб «Ещё»).

  Блок «Синхронизация» — сюда же из «Настроек» (activity_settings.xml раньше держал
  его пятой группой): статус связки с сервером нужен на виду сразу на «Ещё», а не
  на экран глубже.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:text="Ещё"
        android:textSize="25sp"
        android:textStyle="bold"
        android:fontFamily="@font/caprasimo"
        android:textColor="@color/colorTextPrimary"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_above="@id/bottomNav"
        android:paddingLeft="18dp"
        android:paddingRight="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/rowAccountsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="14dp">

                <LinearLayout android:id="@+id/rowAccounts" style="@style/MoreRow" android:onClick="onMoreAccounts">
                    <TextView style="@style/MoreRowGlyph" android:text="▤"/>
                    <TextView style="@style/MoreRowLabel" android:text="Кошельки и категории"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
                <View style="@style/MoreRowDivider"/>

                <LinearLayout android:id="@+id/rowRecurring" style="@style/MoreRow" android:onClick="onMoreRecurring">
                    <TextView style="@style/MoreRowGlyph" android:text="↻"/>
                    <TextView style="@style/MoreRowLabel" android:text="Повторяющиеся операции"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Та же вёрстка блока, что раньше была в activity_settings.xml
                 (SettingsGroupLabel + bg_card, строки с chevron/переключателем). -->
            <TextView style="@style/SettingsGroupLabel" android:text="СИНХРОНИЗАЦИЯ"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:id="@+id/rowServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onPickServerUrl">

                    <!-- Подпись — во всю длину, сжимается значение: длинный адрес рвал подпись на две строки. Многоточие посередине — видно и начало адреса, и порт. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="Адрес сервера"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:id="@+id/serverUrlValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:text="http://localhost:8090/"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorexpanse"
                        android:layout_marginEnd="6dp"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>

                <View style="@style/MoreRowDivider"/>

                <LinearLayout
                    android:id="@+id/rowLinkServer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onLinkServer">

                    <!-- Как у «Адрес сервера» выше: длинный email сжимается многоточием, а не рвёт подпись. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="Связать с сервером"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:id="@+id/linkStatusValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:singleLine="true"
                        android:ellipsize="middle"
                        android:text="Не подключено"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginEnd="6dp"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>

                <View style="@style/MoreRowDivider"/>

                <!-- Веб-версию отдаёт тот же гейтвей (GET / → wallet-web), что и API синка,
                     поэтому открывается «Адрес сервера» выше — в браузере по умолчанию. -->
                <LinearLayout
                    android:id="@+id/rowOpenWeb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onOpenWeb">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Открыть веб-версию"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="в браузере"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginEnd="6dp"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>

                <View style="@style/MoreRowDivider"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Автоматическое подключение"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"/>

                        <TextView
                            android:id="@+id/rowAutoConnectInterval"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="раз в час"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorexpanse"
                            android:onClick="onPickAutoConnectInterval"/>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/switchAutoConnect"
                        android:layout_width="46dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_switch_off"
                        android:onClick="onToggleAutoConnect">
                        <View
                            android:id="@+id/switchAutoConnectThumb"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_margin="2dp"
                            android:background="@drawable/bg_switch_thumb"/>
                    </FrameLayout>
                </LinearLayout>

                <View style="@style/MoreRowDivider"/>

                <!-- Уведомление после фонового синка — приходит только при включённом
                     автоподключении, с его же задержкой (sync.NewOperationsNotifier). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Уведомлять о новых операциях"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="периодические, из бота, веба и с других устройств"
                            android:textSize="12.5sp"
                            android:textColor="@color/colorTextSecondary"/>
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/switchNotifyNewOperations"
                        android:layout_width="46dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_switch_off"
                        android:onClick="onToggleNotifyNewOperations">
                        <View
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_margin="2dp"
                            android:background="@drawable/bg_switch_thumb"/>
                    </FrameLayout>
                </LinearLayout>

                <View style="@style/MoreRowDivider"/>

                <LinearLayout
                    android:id="@+id/rowSyncNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:onClick="onSyncNow">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Синхронизировать сейчас"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextPrimary"/>

                    <TextView
                        android:id="@+id/syncNowStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginEnd="6dp"/>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_chevron_right"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/moreList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="14dp">

                <!-- Каждая строка — copy более_item_layout.xml, здесь для наглядности статично.
                     Последняя строка группы без нижнего разделителя. -->
                <LinearLayout android:id="@+id/rowRates" style="@style/MoreRow" android:onClick="onMoreRates">
                    <TextView style="@style/MoreRowGlyph" android:text="⇅"/>
                    <TextView style="@style/MoreRowLabel" android:text="Курсы валют"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
                <View style="@style/MoreRowDivider"/>

                <LinearLayout android:id="@+id/rowIcons" style="@style/MoreRow" android:onClick="onMoreIcons">
                    <TextView style="@style/MoreRowGlyph" android:text="▦"/>
                    <TextView style="@style/MoreRowLabel" android:text="Иконки и категории"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
                <View style="@style/MoreRowDivider"/>

                <LinearLayout android:id="@+id/rowImport" style="@style/MoreRow" android:onClick="onMoreImport">
                    <TextView style="@style/MoreRowGlyph" android:text="↧"/>
                    <TextView style="@style/MoreRowLabel" android:text="Импорт из файла"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
                <View style="@style/MoreRowDivider"/>

                <LinearLayout android:id="@+id/rowSettings" style="@style/MoreRow" android:onClick="onMoreSettings">
                    <TextView style="@style/MoreRowGlyph" android:text="⛭"/>
                    <TextView style="@style/MoreRowLabel" android:text="Настройки"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include android:id="@+id/bottomNav" layout="@layout/view_bottom_nav"/>
</RelativeLayout>
