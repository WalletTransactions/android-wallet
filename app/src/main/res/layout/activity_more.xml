<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран «Ещё» — таб нижней панели (navMore). Пункты бокового drawer переехали сюда.
  Панель нижней навигации подключена (view_bottom_nav, активный таб «Ещё»).

  Блок «Интеграции» (сервер, Google, Telegram, синхронизация) — с 2026-10-11 отдельный
  экран activity_integrations.xml, здесь на него одна строка.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:text="Ещё"
        android:textSize="25sp"
        android:textStyle="bold"
        android:fontFamily="@font/caprasimo"
        android:textColor="@color/colorTextPrimary"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_above="@id/bottomNav"
        android:paddingLeft="18dp"
        android:paddingRight="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/rowAccountsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="14dp">

                <LinearLayout android:id="@+id/rowAccounts" style="@style/MoreRow" android:onClick="onMoreAccounts">
                    <TextView style="@style/MoreRowGlyph" android:text="▤"/>
                    <TextView style="@style/MoreRowLabel" android:text="Кошельки и категории"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
                <View style="@style/MoreRowDivider"/>

                <LinearLayout android:id="@+id/rowRecurring" style="@style/MoreRow" android:onClick="onMoreRecurring">
                    <TextView style="@style/MoreRowGlyph" android:text="↻"/>
                    <TextView style="@style/MoreRowLabel" android:text="Повторяющиеся операции"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Трата своими словами через wallet-ai (AiActivity). Активен, только если
                 есть вход в аккаунт и сервер говорит, что ИИ включён (MoreActivity.refreshAiRow);
                 иначе неактивен, причина — подписью. -->
            <LinearLayout
                android:id="@+id/rowAiCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="14dp">

                <LinearLayout android:id="@+id/rowAi" style="@style/MoreRow" android:onClick="onMoreAi">
                    <TextView style="@style/MoreRowGlyph" android:text="✦"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            style="@style/MoreRowLabel"
                            android:layout_width="match_parent"
                            android:layout_weight="0"
                            android:text="ИИ"/>
                        <TextView
                            android:id="@+id/rowAiHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="13dp"
                            android:textSize="12.5sp"
                            android:textColor="@color/colorTextSecondary"
                            android:text="Трата своими словами"/>
                    </LinearLayout>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Сервер, Google, Telegram, веб-версия, синхронизация — отдельный экран
                 «Интеграции» (IntegrationsActivity), до 2026-10-11 стояли блоком здесь. -->
            <LinearLayout
                android:id="@+id/rowIntegrationsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="14dp">

                <LinearLayout android:id="@+id/rowIntegrations" style="@style/MoreRow" android:onClick="onMoreIntegrations">
                    <TextView style="@style/MoreRowGlyph" android:text="⇄"/>
                    <TextView style="@style/MoreRowLabel" android:text="Интеграции"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/moreList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="14dp">

                <!-- Каждая строка — copy более_item_layout.xml, здесь для наглядности статично.
                     Последняя строка группы без нижнего разделителя. -->
                <LinearLayout android:id="@+id/rowRates" style="@style/MoreRow" android:onClick="onMoreRates">
                    <TextView style="@style/MoreRowGlyph" android:text="⇅"/>
                    <TextView style="@style/MoreRowLabel" android:text="Курсы валют"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
                <View style="@style/MoreRowDivider"/>

                <LinearLayout android:id="@+id/rowIcons" style="@style/MoreRow" android:onClick="onMoreIcons">
                    <TextView style="@style/MoreRowGlyph" android:text="▦"/>
                    <TextView style="@style/MoreRowLabel" android:text="Иконки и категории"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
                <View style="@style/MoreRowDivider"/>

                <LinearLayout android:id="@+id/rowImport" style="@style/MoreRow" android:onClick="onMoreImport">
                    <TextView style="@style/MoreRowGlyph" android:text="↧"/>
                    <TextView style="@style/MoreRowLabel" android:text="Импорт из файла"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
                <View style="@style/MoreRowDivider"/>

                <LinearLayout android:id="@+id/rowSettings" style="@style/MoreRow" android:onClick="onMoreSettings">
                    <TextView style="@style/MoreRowGlyph" android:text="⛭"/>
                    <TextView style="@style/MoreRowLabel" android:text="Настройки"/>
                    <ImageView style="@style/MoreRowChevron"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include android:id="@+id/bottomNav" layout="@layout/view_bottom_nav"/>
</RelativeLayout>
