<?xml version="1.0" encoding="utf-8"?>
<!--
  Связка с сервером (org/docs/TODO_mobile_sync.md, Фаза 1; вход по паролю — change
  add-password-login) — открывается с экрана «Ещё» → «Интеграции» → «Связь с Google
  аккаунтом». Какие блоки показывать, решает ответ GET /auth/methods: форма «Email /
  Пароль» (blockPassword), «Создать аккаунт» (форма blockRegister) и кнопка Google
  (blockGoogle). Экран прокручивается: на узких телефонах и с клавиатурой всё не влезает.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/activity_sync_link_text_1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/caprasimo"
                android:textColor="@color/colorTextPrimary"
                android:paddingBottom="16dp"/>

        <!-- Предупреждение над полями, если адрес сервера начинается с http:// -->
        <TextView
                android:id="@+id/textInsecureWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/link_password_insecure_warning"
                android:textSize="13sp"
                android:textColor="@color/colorexpanse"
                android:paddingBottom="12dp"
                android:visibility="gone"/>

        <!-- Вход по паролю -->
        <LinearLayout
                android:id="@+id/blockPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <EditText
                    android:id="@+id/editEmail"
                    style="@style/FormInputPill"
                    android:hint="@string/link_password_hint_email"
                    android:inputType="textEmailAddress"
                    android:importantForAutofill="yes"
                    android:autofillHints="emailAddress"/>

            <!-- saveEnabled=false: пароль не попадает в сохранённое состояние Activity (поворот экрана) -->
            <EditText
                    android:id="@+id/editPassword"
                    style="@style/FormInputPill"
                    android:hint="@string/link_password_hint_password"
                    android:inputType="textPassword"
                    android:saveEnabled="false"
                    android:importantForAutofill="yes"
                    android:autofillHints="password"/>

            <Button
                    android:id="@+id/buttonLogin"
                    style="@style/AiButtonPrimary"
                    android:text="@string/link_password_login"/>

            <Button
                    android:id="@+id/buttonCreateAccount"
                    style="@style/AiButtonOutline"
                    android:text="@string/link_password_create_account"
                    android:visibility="gone"/>
        </LinearLayout>

        <!-- Регистрация -->
        <LinearLayout
                android:id="@+id/blockRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <EditText
                    android:id="@+id/editRegEmail"
                    style="@style/FormInputPill"
                    android:hint="@string/link_password_hint_email"
                    android:inputType="textEmailAddress"
                    android:importantForAutofill="yes"
                    android:autofillHints="emailAddress"/>

            <EditText
                    android:id="@+id/editRegPassword"
                    style="@style/FormInputPill"
                    android:hint="@string/link_password_hint_password"
                    android:inputType="textPassword"
                    android:saveEnabled="false"
                    android:importantForAutofill="yes"
                    android:autofillHints="newPassword"/>

            <EditText
                    android:id="@+id/editRegPassword2"
                    style="@style/FormInputPill"
                    android:hint="@string/link_register_hint_password2"
                    android:inputType="textPassword"
                    android:saveEnabled="false"
                    android:importantForAutofill="yes"
                    android:autofillHints="newPassword"/>

            <EditText
                    android:id="@+id/editRegName"
                    style="@style/FormInputPill"
                    android:hint="@string/link_register_hint_name"
                    android:inputType="textPersonName|textCapWords"/>

            <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/link_register_note"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary"
                    android:paddingBottom="4dp"/>

            <Button
                    android:id="@+id/buttonRegister"
                    style="@style/AiButtonPrimary"
                    android:text="@string/link_register_button"/>

            <Button
                    android:id="@+id/buttonRegisterBack"
                    style="@style/AiButtonOutline"
                    android:text="@string/link_register_back"/>
        </LinearLayout>

        <!-- Вход через Google -->
        <LinearLayout
                android:id="@+id/blockGoogle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:visibility="gone">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/activity_sync_link_text_2"
                    android:textSize="13sp"
                    android:textColor="@color/colorTextSecondary"
                    android:paddingBottom="12dp"/>

            <Button
                    android:id="@+id/buttonSignIn"
                    style="@style/AiButtonOutline"
                    android:text="@string/activity_sync_link_button_sign_in_text"/>
        </LinearLayout>

        <TextView
                android:id="@+id/textResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:textIsSelectable="true"
                android:textColor="@color/colorTextSecondary"
                android:fontFamily="monospace"/>

    </LinearLayout>

</ScrollView>
