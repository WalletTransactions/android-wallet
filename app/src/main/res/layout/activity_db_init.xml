<?xml version="1.0" encoding="utf-8"?>
<!--
  Первый запуск (openspec fix-first-start-anr): база и справочник создаются
  в фоне, а пользователь видит этот экран вместо зависшего белого окна.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    tools:context=".Activities.DbInitActivity">

    <ProgressBar
        android:id="@+id/progressDbInit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"/>

    <TextView
        android:id="@+id/tvDbInit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/db_init_preparing"
        android:textColor="@color/colorTextSecondary"
        android:textSize="16sp"/>
</LinearLayout>
