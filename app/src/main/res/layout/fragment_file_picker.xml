<?xml version="1.0" encoding="utf-8"?>
<!--
  Выбор CSV/JSON-файла: строка «Выбрать файл» + «Формат» (диалог с описанием
  формата, см. FilePickerFragment.setFormatInfo) + путь. Id и типы вью прежние
  (btn_choose_file — Button, tv_file_path — TextView), btn_format_info новый,
  скрыт (GONE) пока ImportActivity не вызовет setFormatInfo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:tools="http://schemas.android.com/tools"
             android:id="@+id/fragment_item_edit_content"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             tools:context=".Activities.Fragments.FilePickerFragment">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <Button
                android:id="@+id/btn_choose_file"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_pill_secondary"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:stateListAnimator="@null"
                android:text="@string/fragment_file_picker_btn_choose_file_text"
                android:textAllCaps="false"
                android:textColor="@color/colorTextPrimary"
                android:textSize="13sp"
                android:textStyle="bold"/>

        <Button
                android:id="@+id/btn_format_info"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_secondary"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:stateListAnimator="@null"
                android:text="@string/fragment_file_picker_btn_format_info_text"
                android:textAllCaps="false"
                android:textColor="@color/colorexpanse"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"/>

        <TextView
                android:id="@+id/tv_file_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="start"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/colorTextSecondary"
                android:textSize="12sp"/>
    </LinearLayout>

</FrameLayout>
