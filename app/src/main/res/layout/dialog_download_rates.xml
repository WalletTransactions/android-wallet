<?xml version="1.0" encoding="utf-8"?>
<!-- Нижний лист «Загрузка котировок». Открывается кнопкой ↧ на карточке пары. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dialog_download_rates_text_1"
        android:textSize="21sp"
        android:textStyle="bold"
        android:fontFamily="@font/caprasimo"
        android:textColor="@color/colorTextPrimary"
        android:layout_marginBottom="16dp"/>

    <TextView style="@style/SettingsGroupLabel" android:text="@string/dialog_download_rates_text_2"/>
    <LinearLayout
        android:id="@+id/rowSource"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input_pill"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_marginBottom="16dp"
        android:onClick="onPickSource">

        <TextView
            android:id="@+id/sourceValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dialog_download_rates_source_value_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"/>

        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_chevron_right" android:rotation="90"/>
    </LinearLayout>

    <TextView style="@style/SettingsGroupLabel" android:text="@string/dialog_download_rates_text_3"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/inputFrom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_input_pill"
            android:gravity="center"
            android:hint="@string/dialog_download_rates_input_from_hint"
            android:textSize="13.5sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:text="—"
            android:textColor="@color/colorTextSecondary"/>

        <EditText
            android:id="@+id/inputTo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_input_pill"
            android:gravity="center"
            android:hint="@string/dialog_download_rates_input_to_hint"
            android:textSize="13.5sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView style="@style/SettingsGroupLabel" android:text="@string/dialog_download_rates_text_4"/>
    <RadioGroup
        android:id="@+id/radioGroupFreq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">

        <RadioButton
            android:id="@+id/radioDay"
            style="@style/PillRadioRow"
            android:text="@string/dialog_download_rates_radio_day_text"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/radioMonday"
            style="@style/PillRadioRow"
            android:text="@string/dialog_download_rates_radio_monday_text"/>

        <RadioButton
            android:id="@+id/radioMonth"
            style="@style/PillRadioRow"
            android:text="@string/dialog_download_rates_radio_month_text"/>
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="9dp"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center"
            android:text="@string/dialog_download_rates_btn_cancel_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:onClick="onCancelDownload"/>

        <TextView
            android:id="@+id/btnDownload"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_primary"
            android:gravity="center"
            android:text="@string/dialog_download_rates_btn_download_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorSurface"
            android:onClick="onRunDownload"/>
    </LinearLayout>
</LinearLayout>