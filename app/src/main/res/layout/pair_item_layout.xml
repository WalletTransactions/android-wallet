<?xml version="1.0" encoding="utf-8"?>
<!-- Строка валютной пары в списке «Курсы валют». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_row"
    android:padding="12dp"
    android:layout_marginBottom="10dp">

    <FrameLayout android:layout_width="56dp" android:layout_height="34dp">
        <ImageView android:id="@+id/flagA" android:layout_width="34dp" android:layout_height="34dp"
            android:layout_gravity="start" app:srcCompat="@drawable/ic_flag_placeholder"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>
        <ImageView android:id="@+id/flagB" android:layout_width="34dp" android:layout_height="34dp"
            android:layout_gravity="end" app:srcCompat="@drawable/ic_flag_placeholder"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">

        <TextView android:id="@+id/pairName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="USD/RUB" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/colorTextPrimary"/>
        <TextView android:id="@+id/pairDate" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/pair_item_layout_pair_date_text" android:textSize="11.5sp" android:textColor="@color/colorTextSecondary"/>
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/pairRate" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="78,4200" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/colorTextPrimary"/>
        <TextView android:id="@+id/pairDelta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+0,42%" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/colorprofit"/>
    </LinearLayout>

    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="6dp" android:src="@drawable/ic_chevron_right"/>
</LinearLayout>