<?xml version="1.0" encoding="utf-8"?>
<!--
  Экран кода (LockActivity), телефон боком: заголовок и точки слева, клавиатура справа.
  В одну колонку, как в портретной разметке, четыре ряда клавиш не помещались по высоте —
  нижний ряд (ОК / 0 / ⌫) уходил за край, и код было не ввести. Те же id, что в layout/.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@color/colorBackground"
    android:paddingLeft="21dp"
    android:paddingRight="21dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/main_icon"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/lockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="22sp"
            android:fontFamily="@font/caprasimo"
            android:textColor="@color/colorTextPrimary"/>

        <TextView
            android:id="@+id/lockMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minLines="2"
            android:gravity="center"
            android:textSize="13.5sp"
            android:textColor="@color/colorTextSecondary"/>

        <LinearLayout
            android:id="@+id/lockDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"/>

        <TextView
            android:id="@+id/lockForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="8dp"
            android:text="Забыли код?"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:onClick="onForgotPin"/>
    </LinearLayout>

    <include
        layout="@layout/lock_keypad"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"/>
</LinearLayout>
