<?xml version="1.0" encoding="utf-8"?>
<!--
  Основная пилюля для кнопок, которые гасятся setEnabled(false):
  у bg_pill_primary нет неактивного состояния, и выключенная кнопка
  выглядела бы рабочей.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/colorTextHint"/>
            <corners android:radius="999dp"/>
        </shape>
    </item>
    <item android:drawable="@drawable/bg_pill_primary"/>
</selector>
