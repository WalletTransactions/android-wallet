<?xml version="1.0" encoding="utf-8"?>
<!-- Общие стили для новых экранов: настройки, курсы валют, список валют, фильтр. -->
<resources>
    <style name="SettingsGroupLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:layout_marginBottom">9dp</item>
    </style>

    <!-- Поле ввода в форме: пилюля на поверхности, высота 48. -->
    <style name="FormInputPill">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@drawable/bg_input_pill</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textColorHint">@color/colorTextHint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
      Клавиша цифровой клавиатуры на экране операции.

      Зазор — поля по 3dp со всех сторон, а не один отступ справа и сверху: клавиатура
      собрана из двух блоков (три колонки слева и одна справа), и при одностороннем
      отступе они делили бы ширину по-разному — колонки не совпали бы. Отступы самой
      клавиатуры на эти 3dp уменьшены, край экрана остался прежним.
    -->
    <style name="KeypadKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Клавиша действия (+ − × ÷) — правая колонка. Отличается только цветом,
         чтобы не путать её с цифрами: своих ресурсов под тему заводить не нужно. -->
    <style name="KeypadKeyOperator" parent="KeypadKey">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Очистка поля целиком (C). Цвет расхода — как предупреждение: соседний ⌫
         стирает один знак, а эта клавиша сносит всё набранное. -->
    <style name="KeypadKeyClear" parent="KeypadKey">
        <item name="android:textColor">@color/colorexpanse</item>
    </style>

    <!-- Та же клавиша, но с иконкой вместо текста: см. ic_backspace.xml. -->
    <style name="KeypadKeyIcon" parent="KeypadKey">
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Клавиша экрана кода доступа (activity_lock.xml): выше — клавиатура там одна на экране. -->
    <style name="LockKey" parent="KeypadKey">
        <item name="android:layout_height">@dimen/lock_key_height</item>
        <item name="android:textSize">24sp</item>
        <item name="android:onClick">onLockKey</item>
    </style>

    <!-- Экран правила повторяющейся операции (activity_recurring_operation.xml). -->
    <!-- Строка-выбор: счёт, частота, шаг — карточка с значением и шевроном. -->
    <style name="RecurringPickerRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@drawable/bg_card_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="RecurringPickerIcon">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="RecurringPickerValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- День недели еженедельного повтора: отмеченный красится кодом (bg_chip_selected). -->
    <style name="RecurringDayChip" parent="FilterChip">
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
