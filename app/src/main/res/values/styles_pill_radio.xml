<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Строка радио-выбора внутри пилюльной карточки: используется в dialog_download_rates.xml. -->
    <style name="PillRadioRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input_pill</item>
        <item name="android:button">@drawable/bg_radio_dot_native</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:drawablePadding">12dp</item>
    </style>
</resources>