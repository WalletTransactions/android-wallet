<?xml version="1.0" encoding="utf-8"?>
<!-- Экран «ИИ» (activity_ai.xml). Кнопки — как на «Экспорте» (activity_export.xml). -->
<resources>
    <style name="AiButtonPrimary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">9dp</item>
        <item name="android:background">@drawable/bg_pill_primary_state</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/colorSurface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="AiButtonOutline" parent="AiButtonPrimary">
        <item name="android:background">@drawable/bg_pill_outline_state</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>
    <style name="AiCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">14dp</item>
    </style>
    <style name="AiLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
    </style>
    <style name="AiValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
        <item name="android:textColorHint">@color/colorTextHint</item>
    </style>
    <style name="AiNote">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
        <item name="android:visibility">gone</item>
    </style>
    <style name="AiWarning" parent="AiNote">
        <item name="android:textColor">@color/colorexpanse</item>
    </style>
</resources>
