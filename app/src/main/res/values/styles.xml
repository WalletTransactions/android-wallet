<resources>

    <!--
      Base application theme.

      DayNight, а не Light: именно этот родитель включает квалификатор -night, из-за
      которого values-night/colors.xml подменяет палитру. Какой из вариантов взять,
      решает AppCompatDelegate.setDefaultNightMode — см. AppSettings.applyThemeMode.
    -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Фон окна: без него под экраном остаётся фон платформы, и в тёмной теме
             при запуске и переходах между активностями мигает белым. -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <!-- Иначе полосу статуса красит colorPrimaryDark, а он в тёмной теме светлый. -->
        <item name="android:statusBarColor">@color/colorStatusBar</item>
    </style>

    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar"/>

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light"/>


</resources>
