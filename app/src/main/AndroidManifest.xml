<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.example.wallettransactions">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Уведомление "нужна повторная авторизация" от SyncWorker — на
         Android 13+ без него сервис уведомлений просто не покажет ничего,
         не упадёт; запрашивается у пользователя при включении автосинхронизации
         (см. IntegrationsActivity.onToggleAutoConnect). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Экран «ИИ»: кнопка микрофона видна, только если есть системное
         распознавание речи; с Android 11 без <queries> resolveActivity его не найдёт. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH"/>
        </intent>
    </queries>

    <!-- LAN-only на этом этапе, без TLS (org/docs/TODO_mobile_sync.md, п. 1.4
         и "Открытые вопросы") — адрес сервера вводится вручную (экран
         «Ещё») и может быть любым LAN IP, поэтому точечный
         network-security-config под конкретный хост не подходит: адрес
         меняется от инсталляции к инсталляции. С targetSdk 28+ обычный
         HTTP иначе просто запрещён политикой ОС ("CLEARTEXT communication
         ... not permitted"). Снять, когда появится TLS/публичный домен —
         см. открытый вопрос в плане. -->
    <application
            android:name=".WalletApplication"
            android:allowBackup="true"
            android:fullBackupContent="@xml/backup_rules"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:icon="@mipmap/main_icon"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/main_icon"
            android:supportsRtl="true"
            android:usesCleartextTraffic="true"
            android:theme="@style/AppTheme">
        <activity android:name=".Activities.ExportActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity android:name=".Activities.ResetDataActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity android:name=".Activities.AccountItemActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity
                android:name=".Activities.FilterActivity"
                android:label="@string/title_activity_filter"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity
                android:name=".Activities.MultiPickerActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:windowSoftInputMode="adjustResize"
                android:exported="false"/>
        <activity
                android:name=".Activities.CurrencyFormActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false"/>
        <activity
                android:name=".Activities.IconPickerActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false"/>
        <activity android:name=".Activities.CurrencyPairRateListActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity android:name=".Activities.AddCategoryActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity android:name=".Activities.AddWalletActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity android:name=".Activities.SettingsActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <!-- Код доступа (security.AppLock). Без анимации: замок должен появиться сразу,
             а не выезжать поверх содержимого, которое он прячет. -->
        <activity android:name=".Activities.LockActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false"/>
        <activity android:name=".Activities.RecurringOperationListActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity android:name=".Activities.RecurringOperationActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:windowSoftInputMode="adjustResize"
                android:exported="false">
        </activity>
        <activity android:name=".Activities.MoreActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity android:name=".Activities.CurrencyPickerActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity
                android:name=".Activities.CurrencyPairListActivity"
                android:label="@string/title_currencypair_list"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity
                android:name=".Activities.CurrencyPairDetailActivity"
                android:label="@string/title_currencypair_detail"
                android:parentActivityName=".Activities.CurrencyPairListActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
            <meta-data
                    android:name="android.support.PARENT_ACTIVITY"
                    android:value="com.example.wallettransactions.Activities.CurrencyPairListActivity"/>
        </activity>
        <activity
                android:name=".Activities.AccountActivity"
                android:label="@string/title_activity_account"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity android:name=".Activities.AccountPickerActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:windowSoftInputMode="adjustResize"
                android:exported="false"/>
        <activity android:name=".Activities.ImportActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity android:name=".Activities.IconManagerActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false">
        </activity>
        <activity android:name=".Activities.IconCropActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false"/>
        <activity
                android:name=".Activities.MainActivity"
                android:label="@string/app_name"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
                android:name=".Activities.ReportActivity"
                android:label="@string/title_activity_report"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false"/>
        <activity
                android:name=".Activities.TransactionActivity"
                android:label="@string/caption_add_transaction"
                android:theme="@style/AppTheme.NoActionBar"
                android:windowSoftInputMode="adjustResize"
                android:exported="false"/>

        <!-- Сервер, Google, Telegram, синхронизация — «Ещё» → «Интеграции». -->
        <!-- Трата своими словами через wallet-ai (openspec changes/add-ai-client).
             Принимает «Поделиться» текстом: сообщение банка из Viber/SMS попадает
             в поле, разбор пользователь запускает сам. configChanges — поворот не
             должен пересоздавать экран: ожидание разбора привязано к нему.
             singleTop — повторное «Поделиться» при открытом экране приходит в
             onNewIntent, а не складывает в задачу ещё один экран «ИИ». -->
        <activity android:name=".Activities.AiActivity"
                android:launchMode="singleTop"
                android:theme="@style/AppTheme.NoActionBar"
                android:label="Кошелёк"
                android:windowSoftInputMode="adjustResize"
                android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>

        <!-- Экран «Выписка» (openspec changes/add-ai-statement-import): импорт выписки
             через wallet-ai. Принимает «Поделиться» файлом (EXTRA_STREAM) из банковского
             приложения: экран открывается с файлом, загрузку пользователь запускает сам.
             configChanges и singleTop — как у экрана «ИИ»: опрос разбора привязан к экрану. -->
        <activity android:name=".Activities.StatementImportActivity"
                android:launchMode="singleTop"
                android:theme="@style/AppTheme.NoActionBar"
                android:label="Выписка в Кошелёк"
                android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
                android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="text/csv"/>
                <data android:mimeType="text/comma-separated-values"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>

        <activity android:name=".Activities.IntegrationsActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false"/>

        <!-- Вход/связка с сервером (org/docs/TODO_mobile_sync.md, Фаза 1) —
             открывается с экрана «Ещё» → «Интеграции» → «Связь с Google аккаунтом», см. класс. -->
        <activity android:name=".Activities.SyncLinkActivity"
                android:theme="@style/AppTheme.NoActionBar"
                android:exported="false"/>

        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_provider_paths"/>
        </provider>
    </application>

</manifest>