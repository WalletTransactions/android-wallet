SELECT id, date, acc_fr_id, acc_to_id, amount, currency_id, comment, af.ico_name acc_fr_ico_name, at.ico_name acc_to_ico_name 
FROM transactions t 
join accounts af on af.id = t.acc_fr_id 
join accounts at on at.id = t.acc_to_id

--- по категориям
SELECT фа af.name acc_fr_name, at.name acc_to_name, round( sum(t.amount),2) turn_over
FROM transactions t 
join accounts af on af.id = t.acc_fr_id 
join accounts at on at.id = t.acc_to_id
where t.date between 0 and 50000 and af.id in (af.id) and at.id in (at.id)
group by af.name, at.name
order by round( sum(t.amount),2)


select a.id, a.name, tf.fr_amount, tt.to_amount, fr_count, to_count, to_count - fr_count  -- sum(tf.amount) amount_fr, sum(tt.amount) amount_to, count(1) 
from accounts a
left join 
(select tf.acc_fr_id,  round(sum(tf.amount),2) fr_amount , count(1) fr_count
from transactions tf
where tf.date between 0 and 50000
group by tf.acc_fr_id ) tf
on a.id = tf.acc_fr_id 
left join 
(select tt.acc_to_id,  round(sum(tt.amount),2) to_amount , count(1) to_count
from transactions tt
where tt.date between 0 and 50000
group by tt.acc_to_id ) tt
on a.id = tt.acc_to_id 
where a.id in (2)


